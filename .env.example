# ---- MediCare backend environment --------------------------------------
# Copy this file to .env (backend) or export the variables in your shell.
# NEVER commit the real values.

# MongoDB Atlas connection string (REQUIRED)
# Atlas UI: Cluster -> Connect -> Drivers -> copy the SRV string
# Make sure your current IP is whitelisted (Network Access) and the DB user exists (Database Access).
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/medicare

# Optional overrides (safe defaults are used when unset)
# Database name inside the cluster (default: medicare / or the db in the URI)
MEDICARE_DB_NAME=medicare
# Comma separated list of allowed frontend origins for CORS
MEDICARE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to false to disable demo data seeding on first run
MEDICARE_SEED_DEMO_DATA=true
# Port for the Spring Boot server (default 8080)
SERVER_PORT=8080
